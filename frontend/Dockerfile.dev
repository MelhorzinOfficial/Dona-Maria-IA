# Frontend Development Dockerfile
# Next.js 15 with hot reload

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

# Start development server with hot reload (listening on all interfaces)
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
