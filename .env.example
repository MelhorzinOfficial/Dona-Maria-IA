# ===================================================================
# Dona Maria IA - Environment Variables Example
# ===================================================================
# Copy this file to .env and fill in the values
# docker-compose will automatically load .env file
# ===================================================================

# ===================================================================
# Database (PostgreSQL)
# ===================================================================
POSTGRES_USER=dona
POSTGRES_PASSWORD=maria
POSTGRES_DB=donamaria
DATABASE_URL=postgresql://dona:maria@postgres:5432/donamaria

# ===================================================================
# Cache (Redis)
# ===================================================================
REDIS_URL=redis://redis:6379

# ===================================================================
# Backend (FastAPI)
# ===================================================================
APP_NAME="Dona Maria IA"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# API Keys (add as needed)
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# ===================================================================
# Frontend (Next.js)
# ===================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="Dona Maria IA"
