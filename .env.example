# ===================================================================
# Dona Maria IA - Dokploy Environment Variables
# ===================================================================
# Configure these in the Dokploy UI under Environment Variables
# NEVER commit sensitive values to version control!
# ===================================================================

# ===================================================================
# Domain Configuration (Dokploy/Traefik) - REQUIRED
# ===================================================================
# Your domains (without https://)
FRONTEND_DOMAIN=donamaria.yourdomain.com
BACKEND_DOMAIN=api.donamaria.yourdomain.com

# ===================================================================
# Database (PostgreSQL) - REQUIRED
# ===================================================================
POSTGRES_USER=dona
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=donamaria

# ===================================================================
# Cache (Redis)
# ===================================================================
# Leave empty for no password (not recommended in production)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===================================================================
# Security - REQUIRED
# ===================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ===================================================================
# Frontend (Next.js) - Build Time
# ===================================================================
# These are baked into the frontend build - must use your actual domains
NEXT_PUBLIC_API_URL=https://api.donamaria.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.donamaria.yourdomain.com
NEXT_PUBLIC_APP_NAME="Dona Maria IA"

# ===================================================================
# AI Provider API Keys (add as needed)
# ===================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
